# Path to Firebase Admin service account JSON (Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# How often to ping the monitored sites (minutes)
CHECK_INTERVAL_MINUTES=5

# Port this monitor server listens on
PORT=3000

# Request timeout per site check (ms)
CHECK_TIMEOUT_MS=10000

# Secret required as ?secret= on /api/cron (leave unset to allow unauthenticated triggers)
CRON_SECRET=

# Comma-separated emails allowed to sign into the dashboard/API. Empty = any Firebase user
# in this project can sign in — set this to lock it down to just you.
ALLOWED_EMAILS=
